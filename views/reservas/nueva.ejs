<section class="panel-formulario">
    <p class="etiqueta"><%= seccion %></p>
    <h1>
        <%= titulo %>
    </h1>
    <% if (error) { %>
        <p class="error" role="alert">
            <%= error %>
        </p>
        <% } %>
            <form action="/reservas" method="post" class="formulario">
                <label for="estudiante">Nombre</label>
                <input id="estudiante" name="estudiante" value="<%= valores.estudiante ?? '' %>" required>
                <label for="email">Email</label>
                <input id="email" name="email" type="email" value="<%= valores.email ?? '' %>" required>
                <label for="sala">Seleccione una sala</label>
                <select id="sala" name="sala">
                    <% salasPermitidas.forEach(sala => { %> 
                        <option value="<%= sala %>" <%= valores.sala === sala ? 'selected' : '' %>><%= sala %></option>
                    <% }) %>
                </select>
                <label>Fecha</label>
                <input id="fecha" name="fecha" type="date" value="<%= valores.fecha ?? '' %>">
                <label for="turno" >Turno</label>
                <select id="turno" name="turno">
                    <% turnosPermitidos.forEach(turno => { %>
                        <option value="<%= turno %>" <%= valores.turno === turno ? 'selected' : '' %>><%= turno %></option>
                    <% }) %>
                </select>
                <label for="personas">Cantidad de personas</label>
                <input id="personas" name="personas" type="number" min="1" max="6" step="1" value="<%= valores.personas || '' %>">
                <button type="submit">Guardar reserva</button>
            </form>
</section>